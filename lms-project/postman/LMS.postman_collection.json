{
  "info": {
    "name": "LMS",
    "description": "eLearning LMS workflow. Run Authentication first, then the folders in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "accessToken", "value": "" },
    { "key": "courseId", "value": "" },
    { "key": "moduleId", "value": "" },
    { "key": "lessonId", "value": "" },
    { "key": "quizId", "value": "" },
    { "key": "enrollmentId", "value": "" },
    { "key": "questionId", "value": "" },
    { "key": "optionId", "value": "" },
    { "key": "learnerId", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register learner",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Ravi\",\n  \"lastName\": \"Shah\",\n  \"email\": \"ravi.new@lms.local\",\n  \"password\": \"Learner@123\"\n}" }
          }
        },
        {
          "name": "Login instructor",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('accessToken', body.accessToken);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"instructor1@lms.local\",\n  \"password\": \"Instructor@123\"\n}" }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/users?page=1&limit=10" }
        },
        {
          "name": "Create instructor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users",
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"New\",\n  \"lastName\": \"Instructor\",\n  \"email\": \"new.instructor@lms.local\",\n  \"password\": \"Instructor@123\",\n  \"role\": \"INSTRUCTOR\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Create course",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('courseId', pm.response.json().id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/courses",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Postman course\",\n  \"description\": \"Created from the Postman collection.\"\n}" }
          }
        },
        {
          "name": "List courses",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/courses?page=1&limit=10" }
        },
        {
          "name": "Get course",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/courses/{{courseId}}" }
        },
        {
          "name": "Publish course",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/courses/{{courseId}}/publish" }
        }
      ]
    },
    {
      "name": "Modules",
      "item": [
        {
          "name": "Create module",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('moduleId', pm.response.json().id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/courses/{{courseId}}/modules",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Getting started\",\n  \"description\": \"The first module.\"\n}" }
          }
        },
        {
          "name": "List modules",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/courses/{{courseId}}/modules" }
        }
      ]
    },
    {
      "name": "Lessons",
      "item": [
        {
          "name": "Create lesson",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('lessonId', pm.response.json().id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/modules/{{moduleId}}/lessons",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"What is a service?\",\n  \"description\": \"Where business rules live.\",\n  \"content\": \"A service holds the rules. The controller only receives the request.\"\n}" }
          }
        },
        {
          "name": "Get lesson",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/lessons/{{lessonId}}" }
        }
      ]
    },
    {
      "name": "Enrollments",
      "item": [
        {
          "name": "Enroll",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('enrollmentId', pm.response.json().id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/enrollments",
            "body": { "mode": "raw", "raw": "{\n  \"courseId\": \"{{courseId}}\"\n}" }
          }
        },
        {
          "name": "My enrollments",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/enrollments/me" }
        }
      ]
    },
    {
      "name": "Progress",
      "item": [
        {
          "name": "Complete lesson",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/progress/lessons/{{lessonId}}/complete" }
        },
        {
          "name": "My progress",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/progress/me" }
        }
      ]
    },
    {
      "name": "Assessments",
      "item": [
        {
          "name": "Create quiz",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('quizId', pm.response.json().id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/courses/{{courseId}}/quizzes",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Basics quiz\",\n  \"description\": \"One question.\",\n  \"passingPercentage\": 50\n}" }
          }
        },
        {
          "name": "Add question",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('questionId', body.id);", "const correct = body.options.find((option) => option.isCorrect);", "if (correct) pm.collectionVariables.set('optionId', correct.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/quizzes/{{quizId}}/questions",
            "body": { "mode": "raw", "raw": "{\n  \"questionText\": \"Where do business rules live?\",\n  \"options\": [\n    { \"optionText\": \"In the service\", \"isCorrect\": true },\n    { \"optionText\": \"Only in the React page\", \"isCorrect\": false }\n  ]\n}" }
          }
        },
        {
          "name": "Submit quiz",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/quizzes/{{quizId}}/submit",
            "body": { "mode": "raw", "raw": "{\n  \"answers\": [\n    { \"questionId\": \"{{questionId}}\", \"selectedOptionId\": \"{{optionId}}\" }\n  ]\n}" }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Overview",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/reports/overview" }
        },
        {
          "name": "Learner progress",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/reports/learners/{{learnerId}}/progress" }
        },
        {
          "name": "Course completion",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/reports/courses/{{courseId}}/completion" }
        },
        {
          "name": "Quiz performance",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/reports/quizzes/{{quizId}}/performance" }
        }
      ]
    }
  ]
}
